# Chess.com public username to analyze (no auth required for the public API)
CHESS_USERNAME=your_chess_com_username

# Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# Path to the Stockfish binary. On CI this is installed via apt-get and is
# just "stockfish". Locally on macOS: `brew install stockfish`.
STOCKFISH_PATH=stockfish
STOCKFISH_DEPTH=14
# Number of opening plies excluded from ACPL / top-1 match stats.
STOCKFISH_BOOK_PLIES=10

# Max games to pull from the most recent Chess.com monthly archive per run.
GAMES_LIMIT=10

# Where the running history file lives.
ANALYSIS_FILE=data/analysis.json
REPORTS_DIR=reports

# --- Email delivery (optional; omit SMTP_HOST to skip sending) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=app-password
EMAIL_FROM=you@example.com
EMAIL_TO=you@example.com
